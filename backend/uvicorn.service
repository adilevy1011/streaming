[Unit]
Description=adlv Media API backend
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/streaming/backend
EnvironmentFile=/etc/streaming/backend.env
ExecStart=/var/www/streaming/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=5
# Do not wait indefinitely for an in-flight HLS download/transcode during a
# deploy or restart; terminate the FFmpeg child with the backend.
TimeoutStopSec=15
KillMode=control-group

[Install]
WantedBy=multi-user.target
